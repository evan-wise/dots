{
  "name": "Gloves",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:UTC}",
      "USERNAME": "${localEnv:USER}",
      "USER_HOME": "${localEnv:HOME}"
    }
  },
  // NET_ADMIN/NET_RAW are only needed by init-firewall.sh.
  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],
  "remoteUser": "${localEnv:USER}",
  // ~/.claude and ~/.claude.json are bind-mounted at their host paths by
  // bin/gloves.sh (the same mounts are added to project dev containers).
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096"
  },
  // Mount the project at the same absolute path as on the host.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand"
}
