[Unit]
Description=Animated shader wallpaper (pauses / throttles on battery)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Cycles through every shader every 15 minutes in random order. Power
# management (pause on battery / while locked) is built into shades; see
# `shades --help` for the options.
ExecStart=%h/bin/shades --shader-dir %h/src/shades/shaders --cycle 900 --fade 4 --shuffle
Restart=on-failure
RestartSec=1
TimeoutStopSec=10

[Install]
WantedBy=hyprland-session.target
